generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CORRETOR
  PARCEIRO
}

enum LeadSource {
  INSTAGRAM
  SITE
  WHATSAPP
  INDICACAO
  TRAFEGO_PAGO
  OUTRO
}

enum LeadIntent {
  COMPRAR
  VENDER
  INVESTIR
  ALUGAR
}

enum LeadStage {
  NOVO
  PRIMEIRO_CONTATO
  QUALIFICADO
  OPCOES_ENVIADAS
  VISITA_AGENDADA
  PROPOSTA_ENVIADA
  NEGOCIACAO
  FECHADO
  PERDIDO
}

enum InteractionType {
  FORM_SUBMISSION
  WHATSAPP_CLICK
  WHATSAPP_MESSAGE
  TABLE_DOWNLOAD
  EMAIL
  PHONE_CALL
  NOTE
}

enum InteractionChannel {
  SITE
  WHATSAPP
  EMAIL
  PHONE
  INSTAGRAM
  CRM
}

enum PropertyType {
  CASA
  APARTAMENTO
  LOTE
  COMERCIAL
  RURAL
  AREA_PRIVATIVA
  CASA_EM_CONDOMINIO
  CASA_GEMINADA
  CHACARA
  CHACARA_EM_CONDOMINIO
  COBERTURA
  FAZENDA
  FLAT
  GALPAO
  LOJA
  LOTE_EM_CONDOMINIO
  PREDIO
  SALA
  SOBRADO
}

enum PropertyPurpose {
  VENDA
  LOCACAO
  INVESTIMENTO
  LEILAO
  LANCAMENTO
}

enum PropertyStatus {
  DISPONIVEL
  RESERVADO
  VENDIDO
  ALUGADO
  EM_ANALISE
}

enum MediaKind {
  IMAGE
  VIDEO
  TOUR
  DOCUMENT
}

enum MediaStatus {
  PENDENTE
  PROCESSANDO
  PRONTO
  FALHA
}

enum TaskStatus {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum VisitStatus {
  AGENDADA
  REALIZADA
  CANCELADA
  REAGENDADA
}

enum ProposalStatus {
  ENVIADA
  ACEITA
  RECUSADA
  CONTRA_PROPOSTA
  EXPIRADA
}

enum OpportunityStatus {
  ANALISE
  ATIVA
  FECHADA
  DESCARTADA
}

enum AuctionRisk {
  BAIXO
  MEDIO
  ALTO
}

enum PortalPublicationStatus {
  PENDENTE
  PUBLICADO
  ERRO
  PAUSADO
}

enum DevelopmentPublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum DevelopmentStage {
  PRE_LAUNCH
  LAUNCH
  SALES
  FOUNDATION_COMPLETED
  CONSTRUCTION
  ADVANCED_STRUCTURE
  FINISHING
  READY_TO_MOVE
  DELIVERED
}

enum DevelopmentPropertyType {
  COMPLEXO
  APARTAMENTO
  CASA
  LOTE
  SALA_COMERCIAL
  STUDIO
  COBERTURA
}

enum DevelopmentUnitCategory {
  STUDIO
  UM_QUARTO
  DOIS_QUARTOS
  TRES_QUARTOS
  QUATRO_QUARTOS
  GARDEN
  COBERTURA
  DUPLEX
  SALA_COMERCIAL
}

enum DevelopmentUnitStatus {
  DISPONIVEL
  RESERVADA
  VENDIDA
  BLOQUEADA
}

enum DevelopmentMediaKind {
  HERO
  GALLERY
  FLOORPLAN
  VIDEO
  PDF
}

enum DevelopmentMediaCategory {
  HERO
  FACHADA
  LAZER
  DECORADO
  PLANTA
  LOCALIZACAO
  OBRA
  OUTROS
}

enum DevelopmentAmenityType {
  LAZER
  DIFERENCIAL
}

enum DevelopmentLeadStatus {
  NOVO
  EM_ATENDIMENTO
  RECEBEU_TABELA
  AGENDOU_APRESENTACAO
  EM_NEGOCIACAO
  COMPROU
  PERDIDO
}

enum DevelopmentMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SeoPageStatus {
  DRAFT
  PUBLISHED
}

enum SeoListingMode {
  TODOS
  PRONTOS
  PLANTA
  LEILAO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  creci        String?
  role         Role     @default(CORRETOR)
  passwordHash String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedLeads    Lead[]                 @relation("LeadOwnerUser")
  interactions  LeadInteraction[]      @relation("InteractionUser")
  stageChanges  PipelineStageHistory[] @relation("StageChangedByUser")
  tasks         Task[]                 @relation("TaskAssignedUser")
  visits        Visit[]                @relation("VisitAssignedUser")
  proposals     Proposal[]             @relation("ProposalCreatedUser")
  auditLogs     AuditLog[]
  crmSessions   CrmSession[]
  loginAttempts LoginAttempt[]
}

model CrmSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime?
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  reason    String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  userId    String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([userId, createdAt])
}

model Lead {
  id                    String                @id @default(cuid())
  name                  String
  phone                 String
  email                 String?
  source                LeadSource
  intent                LeadIntent
  stage                 LeadStage             @default(NOVO)
  desiredType           PropertyType?
  desiredPurpose        PropertyPurpose?
  budgetMin             Decimal?              @db.Decimal(14, 2)
  budgetMax             Decimal?              @db.Decimal(14, 2)
  desiredCity           String?
  desiredDistrict       String?
  notes                 String?
  lastContactAt         DateTime?
  lgpdConsentAt         DateTime?
  developmentLeadStatus DevelopmentLeadStatus @default(NOVO)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  ownerUserId                 String?
  ownerUser                   User?                @relation("LeadOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  linkedPropertyId            String?
  linkedProperty              Property?            @relation(fields: [linkedPropertyId], references: [id], onDelete: SetNull)
  linkedDevelopmentId         String?
  linkedDevelopment           Development?         @relation(fields: [linkedDevelopmentId], references: [id], onDelete: SetNull)
  linkedDevelopmentUnitTypeId String?
  linkedDevelopmentUnitType   DevelopmentUnitType? @relation("LeadDevelopmentUnitType", fields: [linkedDevelopmentUnitTypeId], references: [id], onDelete: SetNull)
  linkedDevelopmentUnitId     String?
  linkedDevelopmentUnit       DevelopmentUnit?     @relation("LeadDevelopmentUnit", fields: [linkedDevelopmentUnitId], references: [id], onDelete: SetNull)
  linkedOwnerId               String?
  linkedOwner                 Owner?               @relation(fields: [linkedOwnerId], references: [id], onDelete: SetNull)

  interactions LeadInteraction[]
  stageHistory PipelineStageHistory[]
  tasks        Task[]
  visits       Visit[]
  proposals    Proposal[]

  @@index([stage])
  @@index([source])
  @@index([intent])
  @@index([phone])
  @@index([linkedDevelopmentId])
  @@index([linkedDevelopmentUnitTypeId])
  @@index([linkedDevelopmentUnitId])
  @@index([developmentLeadStatus])
}

model LeadInteraction {
  id        String             @id @default(cuid())
  leadId    String
  type      InteractionType
  channel   InteractionChannel
  message   String?
  metadata  Json?
  createdAt DateTime           @default(now())

  lead          Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId    String?
  property      Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  developmentId String?
  development   Development?         @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  unitTypeId    String?
  unitType      DevelopmentUnitType? @relation("InteractionDevelopmentUnitType", fields: [unitTypeId], references: [id], onDelete: SetNull)
  unitId        String?
  unit          DevelopmentUnit?     @relation("InteractionDevelopmentUnit", fields: [unitId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?                @relation("InteractionUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([unitId])
}

model PipelineStageHistory {
  id          String     @id @default(cuid())
  leadId      String
  fromStage   LeadStage?
  toStage     LeadStage
  reason      String?
  createdAt   DateTime   @default(now())
  changedById String?

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StageChangedByUser", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model Owner {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  city      String?
  district  String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
  leads      Lead[]

  @@index([phone])
}

model Builder {
  id                         String    @id @default(cuid())
  name                       String
  slug                       String    @unique
  logoUrl                    String?
  description                String?
  city                       String?
  state                      String?
  foundedYear                Int?
  website                    String?
  instagram                  String?
  deliveredDevelopmentsCount Int?
  deliveredUnitsCount        Int?
  activeProjectsCount        Int?
  institutionalText          String?
  archivedAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  developments Development[]

  @@index([archivedAt])
}

model Development {
  id                           String                       @id @default(cuid())
  slug                         String                       @unique
  title                        String
  tagline                      String?
  summary                      String
  description                  String
  district                     String
  city                         String
  neighborhood                 String?
  address                      String?
  postalCode                   String?
  latitude                     Decimal?                     @db.Decimal(10, 7)
  longitude                    Decimal?                     @db.Decimal(10, 7)
  propertyType                 DevelopmentPropertyType?
  developerName                String?
  builderName                  String?
  builderId                    String?
  stage                        DevelopmentStage             @default(PRE_LAUNCH)
  deliveryDate                 DateTime?
  constructionProgressPct      Int?
  appreciationPotential        String?
  buyerProfile                 String?
  opportunityText              String?
  showInvestmentPotentialBlock Boolean                      @default(true)
  startingPrice                Decimal?                     @db.Decimal(14, 2)
  priceMax                     Decimal?                     @db.Decimal(14, 2)
  areaFromM2                   Decimal?                     @db.Decimal(10, 2)
  areaToM2                     Decimal?                     @db.Decimal(10, 2)
  landAreaM2                   Decimal?                     @db.Decimal(12, 2)
  bedroomsFrom                 Int?
  bedroomsTo                   Int?
  suitesFrom                   Int?
  suitesTo                     Int?
  bathroomsFrom                Int?
  bathroomsTo                  Int?
  parkingFrom                  Int?
  parkingTo                    Int?
  towersCount                  Int?
  floorsCount                  Int?
  elevatorsCount               Int?
  totalUnits                   Int?
  availableUnits               Int?
  incorporationRegistry        String?
  hasPatrimonyOfAffectation    Boolean?
  amenities                    String[]
  differentials                String[]
  projectText                  String?
  apartmentsText               String?
  locationText                 String?
  locationHighlights           String?
  referencePoints              Json?
  regionLiquidityNotes         String?
  mapEmbedUrl                  String?
  tablePdfUrl                  String?
  whatsappMessageTemplate      String?
  ctaPrimaryLabel              String?
  ctaPrimaryUrl                String?
  ctaSecondaryLabel            String?
  ctaSecondaryUrl              String?
  seoTitle                     String?
  seoDescription               String?
  seoOgImageUrl                String?
  seoKeyword                   String?
  seoNoIndex                   Boolean                      @default(false)
  isFeatured                   Boolean                      @default(false)
  displayOrder                 Int                          @default(0)
  showPrice                    Boolean                      @default(true)
  showMap                      Boolean                      @default(true)
  showBuilder                  Boolean                      @default(true)
  showFloorplanTable           Boolean                      @default(true)
  showWhatsappButton           Boolean                      @default(true)
  isPublished                  Boolean                      @default(false)
  status                       DevelopmentPublicationStatus @default(DRAFT)
  archivedAt                   DateTime?
  publishedAt                  DateTime?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt

  builder      Builder?               @relation(fields: [builderId], references: [id], onDelete: SetNull)
  towers       DevelopmentTower[]
  unitTypes    DevelopmentUnitType[]
  units        DevelopmentUnit[]
  media        DevelopmentMedia[]
  amenityItems DevelopmentAmenity[]
  milestones   DevelopmentMilestone[]
  faqs         DevelopmentFaq[]
  leads        Lead[]
  interactions LeadInteraction[]

  @@index([status, stage])
  @@index([city, district])
  @@index([startingPrice])
  @@index([builderId])
  @@index([archivedAt])
  @@index([isFeatured, displayOrder])
}

model DevelopmentTower {
  id                    String    @id @default(cuid())
  developmentId         String
  name                  String
  slug                  String?
  propertyType          DevelopmentPropertyType?
  description           String?
  floorsCount           Int?
  elevatorsCount        Int?
  totalUnits            Int?
  availableUnits        Int?
  deliveryDate          DateTime?
  incorporationRegistry String?
  position              Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  development Development           @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  unitTypes   DevelopmentUnitType[]
  units       DevelopmentUnit[]
  media       DevelopmentMedia[]
  amenityItems DevelopmentAmenity[]

  @@unique([developmentId, slug])
  @@index([developmentId, position])
}

model DevelopmentUnitType {
  id             String                   @id @default(cuid())
  developmentId  String
  towerId        String?
  name           String
  unitCategory   DevelopmentUnitCategory?
  bedrooms       Int?
  suites         Int?
  bathrooms      Int?
  parkingSpaces  Int?
  areaFromM2     Decimal?                 @db.Decimal(10, 2)
  areaToM2       Decimal?                 @db.Decimal(10, 2)
  areaPrivateM2  Decimal?                 @db.Decimal(10, 2)
  areaTotalM2    Decimal?                 @db.Decimal(10, 2)
  priceFrom      Decimal?                 @db.Decimal(14, 2)
  priceTo        Decimal?                 @db.Decimal(14, 2)
  initialPrice   Decimal?                 @db.Decimal(14, 2)
  imageUrl       String?
  isAvailable    Boolean                  @default(true)
  availableUnits Int?
  totalUnits     Int?
  description    String?
  position       Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  development  Development       @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  tower        DevelopmentTower? @relation(fields: [towerId], references: [id], onDelete: SetNull)
  units        DevelopmentUnit[]
  media        DevelopmentMedia[]
  leads        Lead[]            @relation("LeadDevelopmentUnitType")
  interactions LeadInteraction[] @relation("InteractionDevelopmentUnitType")

  @@index([developmentId, position])
  @@index([towerId])
}

model DevelopmentUnit {
  id              String                @id @default(cuid())
  developmentId   String
  towerId         String?
  unitTypeId      String?
  label           String
  unitNumber      String?
  floor           Int?
  status          DevelopmentUnitStatus @default(DISPONIVEL)
  price           Decimal?              @db.Decimal(14, 2)
  areaPrivateM2   Decimal?              @db.Decimal(10, 2)
  areaTotalM2     Decimal?              @db.Decimal(10, 2)
  parkingSpaces   Int?
  orientation     String?
  notes           String?
  position        Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  development  Development          @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  tower        DevelopmentTower?    @relation(fields: [towerId], references: [id], onDelete: SetNull)
  unitType     DevelopmentUnitType? @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  leads        Lead[]               @relation("LeadDevelopmentUnit")
  interactions LeadInteraction[]    @relation("InteractionDevelopmentUnit")

  @@unique([towerId, unitNumber])
  @@index([developmentId, status])
  @@index([towerId, status])
  @@index([unitTypeId, status])
}

model DevelopmentMedia {
  id                String                   @id @default(cuid())
  developmentId     String
  towerId           String?
  unitTypeId        String?
  kind              DevelopmentMediaKind
  category          DevelopmentMediaCategory @default(OUTROS)
  status            MediaStatus              @default(PENDENTE)
  cloudflareMediaId String?
  url               String
  title             String?
  caption           String?
  isPrimary         Boolean                  @default(false)
  position          Int                      @default(0)
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  development Development          @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  tower       DevelopmentTower?    @relation(fields: [towerId], references: [id], onDelete: SetNull)
  unitType    DevelopmentUnitType? @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)

  @@index([developmentId, kind])
  @@index([towerId])
  @@index([unitTypeId])
}

model DevelopmentAmenity {
  id            String                 @id @default(cuid())
  developmentId String
  towerId       String?
  type          DevelopmentAmenityType @default(LAZER)
  label         String
  description   String?
  icon          String?
  isHighlighted Boolean                @default(true)
  position      Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  development Development       @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  tower       DevelopmentTower? @relation(fields: [towerId], references: [id], onDelete: SetNull)

  @@index([developmentId, type, position])
  @@index([towerId, type, position])
}

model DevelopmentMilestone {
  id            String                     @id @default(cuid())
  developmentId String
  title         String
  description   String?
  status        DevelopmentMilestoneStatus @default(NOT_STARTED)
  targetDate    DateTime?
  actualDate    DateTime?
  progressPct   Int?
  position      Int                        @default(0)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  development Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@index([developmentId, position])
}

model DevelopmentFaq {
  id            String   @id @default(cuid())
  developmentId String
  question      String
  answer        String
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  development Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@index([developmentId, position])
}

model Property {
  id                    String          @id @default(cuid())
  slug                  String          @unique
  title                 String
  type                  PropertyType
  purpose               PropertyPurpose
  status                PropertyStatus  @default(DISPONIVEL)
  price                 Decimal         @db.Decimal(14, 2)
  address               String?
  city                  String
  district              String
  postalCode            String?
  googleMapsUrl         String?
  latitude              Decimal?        @db.Decimal(10, 7)
  longitude             Decimal?        @db.Decimal(10, 7)
  areaM2                Decimal?        @db.Decimal(10, 2)
  landAreaM2            Decimal?        @db.Decimal(12, 2)
  bedrooms              Int?
  livingRooms           Int?
  suites                Int?
  bathrooms             Int?
  parkingSpaces         Int?
  description           String
  features              String[]
  legalNotes            String?
  internalNotes         String?
  commissionPct         Decimal?        @db.Decimal(5, 2)
  documents             Json?
  marketAskingValue     Decimal?        @db.Decimal(14, 2)
  marketEstimatedValue  Decimal?        @db.Decimal(14, 2)
  marketOpportunity     Decimal?        @db.Decimal(14, 2)
  marketComparableLinks String[]
  marketLiquidityNotes  String?
  isInvestorHighlight   Boolean         @default(false)
  isAuctionOpportunity  Boolean         @default(false)
  publishedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  ownerId String?
  owner   Owner?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  media               PropertyMedia[]
  leads               Lead[]
  interactions        LeadInteraction[]
  visits              Visit[]
  proposals           Proposal[]
  tasks               Task[]
  investorOpportunity InvestorOpportunity?
  auctionCase         AuctionCase?
  portalPublications  PortalPublication[]

  @@index([status, purpose])
  @@index([city, district])
  @@index([price])
}

model PropertyMedia {
  id                String      @id @default(cuid())
  propertyId        String
  kind              MediaKind
  status            MediaStatus @default(PENDENTE)
  cloudflareMediaId String?
  url               String
  variant           String?
  position          Int         @default(0)
  metadata          Json?
  createdAt         DateTime    @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, kind])
}

model Visit {
  id          String      @id @default(cuid())
  leadId      String
  propertyId  String
  status      VisitStatus @default(AGENDADA)
  scheduledAt DateTime
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  assignedToId String?
  assignedTo   User?    @relation("VisitAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@index([status])
}

model Proposal {
  id            String         @id @default(cuid())
  leadId        String
  propertyId    String
  status        ProposalStatus @default(ENVIADA)
  offeredValue  Decimal        @db.Decimal(14, 2)
  commissionPct Decimal?       @db.Decimal(5, 2)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  createdById String?
  createdBy   User?    @relation("ProposalCreatedUser", fields: [createdById], references: [id], onDelete: SetNull)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(PENDENTE)
  priority    TaskPriority @default(MEDIA)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignedToId String?
  assignedTo   User?     @relation("TaskAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
}

model InvestorOpportunity {
  id               String            @id @default(cuid())
  propertyId       String            @unique
  status           OpportunityStatus @default(ANALISE)
  marketValue      Decimal?          @db.Decimal(14, 2)
  entryValue       Decimal?
  estimatedRoiPct  Decimal?          @db.Decimal(5, 2)
  legalRiskSummary String?
  documentaryRisk  AuctionRisk?
  liquidityRating  Int?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model AuctionCase {
  id              String            @id @default(cuid())
  propertyId      String            @unique
  caseNumber      String?
  courtName       String?
  auctionDate     DateTime?
  minimumBid      Decimal?          @db.Decimal(14, 2)
  estimatedCosts  Decimal?          @db.Decimal(14, 2)
  documentaryRisk AuctionRisk?
  legalStatus     String?
  editalUrl       String?
  status          OpportunityStatus @default(ANALISE)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PortalPublication {
  id           String                  @id @default(cuid())
  propertyId   String
  portalName   String
  externalId   String?
  status       PortalPublicationStatus @default(PENDENTE)
  lastSyncAt   DateTime?
  payload      Json?
  errorMessage String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, portalName])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actorId    String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resource, createdAt])
}

model SeoLandingPage {
  id          String         @id @default(cuid())
  name        String
  path        String         @unique
  city        String
  district    String?
  listingMode SeoListingMode @default(TODOS)
  title       String
  description String
  h1          String
  intro       String
  keywords    String[]
  faqs        Json?
  status      SeoPageStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([city, district])
}
